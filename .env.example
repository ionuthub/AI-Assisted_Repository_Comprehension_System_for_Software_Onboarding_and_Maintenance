# ============================================================================
# GOOGLE GEMINI API KEY (REQUIRED FOR AI EXPLANATIONS)
# ============================================================================
# Get from: https://aistudio.google.com/app/apikey
# IMPORTANT: Keep this secret! Never commit to git.
# 
# LOCAL DEVELOPMENT:
#   - For npm run dev: Add GEMINI_API_KEY below
#   - For vercel dev: Add GEMINI_API_KEY below
# 
# PRODUCTION (Vercel):
#   - Add GEMINI_API_KEY to Vercel Environment Variables
#   - Settings > Environment Variables > Add GEMINI_API_KEY
#   - The serverless function will automatically use it
#
GEMINI_API_KEY=

# GENERATION MODEL (OPTIONAL)
# Overrides the pinned default (gemini-3.5-flash). Set this if Google retires the
# default model, or to pin a specific model version for a reproducible study run.
# Current model IDs: https://ai.google.dev/gemini-api/docs/models
# Retirement schedule:  https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=
# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
# Default: http://localhost:8080,http://localhost:5173,http://localhost:3000
# Production example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ============================================================================
# RATE LIMITING (UPSTASH REDIS)
# ============================================================================
# The API applies a 15-requests-per-minute per-IP limit ONLY when both values are
# set. With them unset the limiter is skipped entirely and the endpoint is
# unmetered, so set them for any deployment that is publicly reachable.
# Get from: https://console.upstash.com -> Redis database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================================
# GITHUB AUTHENTICATION
# ============================================================================
# Private repository access uses the signed-in user's GitHub OAuth token.
# Do not configure a static client-side GitHub token.

# ============================================================================
# SUPABASE CONFIGURATION (REQUIRED FOR AUTH & DATABASE)
# ============================================================================
# Get from: Supabase Dashboard > Project Settings > API
# 
# LOCAL DEVELOPMENT:
#   - Add variables below
# 
# PRODUCTION (Vercel):
#   - Add variables to Vercel Environment Variables
#
VITE_SUPABASE_URL=https://your-project-url.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ============================================================================
# SENTRY ERROR MONITORING (OPTIONAL)
# ============================================================================
# Get from: Sentry Dashboard > Settings > Projects > [Your Project] > Client Keys (DSN)
# Free tier available at: https://sentry.io/signup/
# 
# LOCAL DEVELOPMENT:
#   - Leave empty to disable Sentry in development
#   - Or add VITE_SENTRY_DSN to test error tracking locally
# 
# PRODUCTION (Vercel):
#   - Add VITE_SENTRY_DSN to Vercel Environment Variables
#   - Sentry will automatically capture errors and performance data
#
VITE_SENTRY_DSN=

# ============================================================================
# ANALYTICS (OPTIONAL)
# ============================================================================
# Plausible Analytics (Privacy-friendly, GDPR compliant)
# Get from: https://plausible.io/
# Or use Google Analytics 4
#
VITE_PLAUSIBLE_DOMAIN=
# VITE_GA_MEASUREMENT_ID=

# ============================================================================
# APP VERSION (OPTIONAL)
# ============================================================================
# Used for Sentry release tracking
# Automatically set by CI/CD or use package.json version
#
VITE_APP_VERSION=1.0.0
