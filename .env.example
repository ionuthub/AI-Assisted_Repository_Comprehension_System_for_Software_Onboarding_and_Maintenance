# Google Gemini API Key (required for AI explanations)
# Get from: https://aistudio.google.com/app/apikey
# IMPORTANT: Keep this secret! Never commit to git.

# For local development with vercel dev:
GEMINI_API_KEY=your_api_key_here

# For local development with npm run dev (optional, uses mock API as fallback):
VITE_GEMINI_API_KEY=your_api_key_here
