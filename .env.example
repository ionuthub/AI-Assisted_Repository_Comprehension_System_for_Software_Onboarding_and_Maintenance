# ============================================================================
# GOOGLE GEMINI API KEY (REQUIRED FOR AI EXPLANATIONS)
# ============================================================================
# Get from: https://aistudio.google.com/app/apikey
# IMPORTANT: Keep this secret! Never commit to git.
# 
# LOCAL DEVELOPMENT:
#   - For npm run dev: Add GEMINI_API_KEY below
#   - For vercel dev: Add GEMINI_API_KEY below
# 
# PRODUCTION (Vercel):
#   - Add GEMINI_API_KEY to Vercel Environment Variables
#   - Settings > Environment Variables > Add GEMINI_API_KEY
#   - The serverless function will automatically use it
#
GEMINI_API_KEY=
# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
# Default: http://localhost:5173,http://localhost:3000
# Production example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# GITHUB PERSONAL ACCESS TOKEN (OPTIONAL)
# ============================================================================
# For accessing private repositories
# Get from: https://github.com/settings/tokens
# Scopes needed: repo (full control of private repositories)
# Without this token, only public repositories can be analyzed
# 
# LOCAL DEVELOPMENT:
#   - Add VITE_GITHUB_TOKEN below
# 
# PRODUCTION (Vercel):
#   - Add VITE_GITHUB_TOKEN to Vercel Environment Variables
#   - The token is only used client-side for GitHub API calls
#
VITE_GITHUB_TOKEN=your_github_token_here
