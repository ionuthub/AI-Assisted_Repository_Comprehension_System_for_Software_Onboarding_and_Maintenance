// Figure 1 — Architecture of the repository-comprehension artefact.
//
// Derived from the source at commit 79dafba; the application source is identical to e7d7efe.
// Every node and edge traces to a file and line range recorded in docs/figure1_provenance.md.
//
// Render:  dot -Tpng -Gdpi=400 docs/figure1_architecture.dot -o docs/figure1_architecture.png
//
// Two layout decisions that are not cosmetic:
//   splines=ortho is NOT used. Graphviz silently drops edge labels under it, which would
//   remove the client -> server label stating what crosses the trust boundary.
//   No rank=same groupings, and labels are kept narrow and stacked. Width is what forces
//   the down-scaling that shrinks the text once the figure is placed at 15 cm on the page.

digraph figure1 {
  rankdir = TB;
  compound = true;
  splines = true;
  nodesep = 0.26;
  ranksep = 0.38;
  bgcolor = "white";

  graph [fontname = "Helvetica", fontsize = 11];
  node  [fontname = "Helvetica", fontsize = 10, shape = box, style = "filled",
         fillcolor = "white", color = "black", penwidth = 1.0, margin = "0.12,0.08"];
  edge  [fontname = "Helvetica", fontsize = 9, color = "black", arrowsize = 0.7];

  // ------------------------------------------------------------------ client
  subgraph cluster_client {
    label = "Browser (client)";
    labeljust = "l";
    color = "black";
    penwidth = 1.6;
    fontsize = 12;
    margin = 12;

    input    [label = "Public GitHub URL\nthe only input", shape = parallelogram, fillcolor = "gray97"];
    ingest   [label = "1  Ingestion\ncap 50 files\nexclusions logged", fillcolor = "gray93"];
    analyse  [label = "2  Analysis\nimports · exports\nfunctions · classes\ncomponents · stack\nimport graph ranks", fillcolor = "gray93"];
    index    [label = "3  Indexing\nTF-IDF · cosine", fillcolor = "gray93"];
    store    [label = "Client state\nfiles · analyses\nindex", fillcolor = "white"];
    retrieve [label = "Retrieval\ntop-k 3\n2 500 chars each", fillcolor = "white"];
    present  [label = "4  Presentation\noverview · search\nanswers · viewer\ncoverage", fillcolor = "gray93"];
    verify   [label = "VERIFICATION LAYER\nfile · rank · score\nline range · excerpt\nunverified mentions",
              fillcolor = "gray86", penwidth = 2.2];
    evalsuite [label = "Evaluation suite\ntimings · confidence\nrubric · TLX · SUS\nseeded probes", fillcolor = "gray93"];
    answerkey [label = "Answer key JSON", shape = parallelogram, fillcolor = "gray97"];
    exports   [label = "Session export\nJSON + CSV", shape = parallelogram, fillcolor = "gray97"];
  }

  // ------------------------------------------------------------------ server
  subgraph cluster_server {
    label = "Edge function (server)";
    labeljust = "l";
    color = "black";
    penwidth = 1.6;
    fontsize = 12;
    margin = 12;

    edge_fn [label = "api/explain-code.ts\norigin allowlist\nvalidation · clamp\nrate limit if Redis", fillcolor = "gray93"];
    key     [label = "GEMINI_API_KEY\nserver env only", shape = note, fillcolor = "gray97"];
  }

  // External services, inline rather than a third column.
  github [label = "GitHub\napi: tree, metadata\nraw: file contents", style = "filled,dashed", fillcolor = "gray95"];
  gemini [label = "Gemini API\ngemini-3.5-flash", style = "filled,dashed", fillcolor = "gray95"];
  redis  [label = "Upstash Redis\noptional", style = "filled,dashed", fillcolor = "gray95"];

  // ------------------------------------------------------------------- flow
  input   -> ingest;
  ingest  -> analyse;
  analyse -> index;
  index   -> store;
  store   -> retrieve;
  store   -> present;

  ingest -> github [style = dashed, dir = both, constraint = false];

  retrieve -> verify  [label = "evidence"];
  retrieve -> edge_fn [label = "question +\nselected excerpts\nonly", penwidth = 2.0];

  key     -> edge_fn [style = dotted, arrowhead = none];
  edge_fn -> redis   [style = dashed];
  edge_fn -> gemini  [style = dashed, dir = both, label = "prompt out\nNDJSON back"];
  edge_fn -> present [label = "answer"];

  verify    -> present   [label = "beside every\nanswer", penwidth = 1.8];
  answerkey -> evalsuite;
  present   -> evalsuite [style = invis];
  evalsuite -> exports;
}
